<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         HERENCIA DEL FORMULARIO DE FACTURA DE CLIENTE
         Añadimos campos personalizados a la vista estándar
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_move_form_invoice_customizer" model="ir.ui.view">
        <field name="name">account.move.form.invoice.customizer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Añadimos campos en la cabecera de la factura -->
            <xpath expr="//field[@name='ref']" position="after">
                <field name="expedition_number"
                       placeholder="EXP-2026-001"
                       invisible="move_type != 'out_invoice'"/>
            </xpath>

            <!-- Añadimos badge de días de retraso junto al estado de pago -->
            <xpath expr="//field[@name='payment_state']" position="after">
                <field name="days_overdue"
                       invisible="days_overdue == 0"
                       widget="badge"
                       decoration-danger="days_overdue > 0"/>
            </xpath>

            <!-- Añadimos pestaña de información interna -->
            <xpath expr="//page[@name='other_info']" position="after">
                <page string="Información Interna"
                      name="internal_info"
                      invisible="move_type != 'out_invoice'">
                    <group>
                        <group string="Control interno">
                            <field name="expedition_number"/>
                            <field name="custom_validated"/>
                            <field name="total_with_label"/>
                            <field name="days_overdue"/>
                        </group>
                        <group string="Notas">
                            <field name="internal_notes"
                                   nolabel="1"
                                   placeholder="Notas visibles solo para el equipo interno..."/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>